MODULE ProcedureTypeBad;
TYPE Row = ARRAY 2 OF INTEGER;
  Rec = RECORD n: INTEGER END;
  ArrayResult = PROCEDURE(): Row;
  RecordResult = PROCEDURE(): Rec;
  A = PROCEDURE(x: INTEGER);
  B = PROCEDURE(x: INTEGER);
  Count = PROCEDURE(x, y: INTEGER);
  Mode = PROCEDURE(VAR x: INTEGER);
  RankOne = PROCEDURE(x: ARRAY OF INTEGER);
  RankTwo = PROCEDURE(x: ARRAY OF ARRAY OF INTEGER);
  FInt = PROCEDURE(): INTEGER;
  FByte = PROCEDURE(): BYTE;
  InnerA = PROCEDURE(x: INTEGER);
  InnerB = PROCEDURE(x: INTEGER);
  OuterA = PROCEDURE(callback: InnerA);
  OuterB = PROCEDURE(callback: InnerB);
  ReturnA = PROCEDURE(): InnerA;
  ReturnB = PROCEDURE(): InnerB;
  ArrayOne = ARRAY 1 OF INTEGER;
  ArrayTwo = ARRAY 1 OF INTEGER;
  WithOne = PROCEDURE(value: ArrayOne);
  WithTwo = PROCEDURE(value: ArrayTwo);
  OrderOne = PROCEDURE(x: INTEGER; ch: CHAR);
  OrderTwo = PROCEDURE(ch: CHAR; x: INTEGER);
  Duplicate = PROCEDURE(x: INTEGER; VAR x: INTEGER);
  DuplicateWithin = PROCEDURE(x, x: INTEGER);
VAR a: A;
  count: Count;
  mode: Mode;
  one: RankOne;
  two: RankTwo;
  fint: FInt;
  fbyte: FByte;
  outerA: OuterA;
  outerB: OuterB;
  returnA: ReturnA;
  returnB: ReturnB;
  withOne: WithOne;
  withTwo: WithTwo;
  orderOne: OrderOne;
  orderTwo: OrderTwo;
  n: INTEGER;
BEGIN
  a := count;
  a := mode;
  one := two;
  fint := fbyte;
  outerA := outerB;
  returnA := returnB;
  withOne := withTwo;
  orderOne := orderTwo;
  a := n;
  IF a < a THEN n := 1 END
END ProcedureTypeBad.
